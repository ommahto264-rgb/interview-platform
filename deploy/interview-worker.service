[Unit]
Description=Interview Platform submission worker
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=interview-worker
WorkingDirectory=/opt/interview-platform
Environment=NODE_ENV=production
EnvironmentFile=/etc/interview-platform/worker.env
ExecStart=/usr/bin/node --import tsx apps/worker/src/worker.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target